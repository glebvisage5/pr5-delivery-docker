# параметры окружения приложения (подставляются в compose.yaml)
POSTGRES_DB=delivery
POSTGRES_USER=delivery
POSTGRES_PASSWORD=delivery_pass

# внешний порт Traefik и порт панели Traefik
HTTP_PORT=80
TRAEFIK_DASHBOARD_PORT=8090

# число экземпляров Delivery Service за балансировщиком
DELIVERY_REPLICAS=3
